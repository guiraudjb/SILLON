# Configuration de la sonde de surveillance des sauvegardes SILLON.
#
# ADMIN_EMAIL : destinataire(s) du bilan quotidien et des alertes.
# Plusieurs adresses : separees par des virgules, sans espace.
# Pris en compte immediatement (relu par la sonde a chaque execution,
# aucune reinstallation necessaire apres modification).
ADMIN_EMAIL="equipe.support@example.gouv.fr"
#
# SMTP_RELAY : proxy mail interne (IP ou nom DNS). Laisser vide pour un
# envoi direct par cette machine.
# Pris en compte seulement a l'installation - apres modification,
# relancer : sudo apt-get install --reinstall sillon-backup-server-survey
SMTP_RELAY=""
