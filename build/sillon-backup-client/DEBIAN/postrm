#!/bin/bash
set -e

MOUNT_POINT="/mnt/savesillon"
FSTAB="/etc/fstab"

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    echo "Nettoyage de la configuration de sauvegarde SILLON (client)..."

    systemctl stop mnt-savesillon.automount 2>/dev/null || true
    umount "$MOUNT_POINT" 2>/dev/null || true

    if grep -q "[[:space:]]${MOUNT_POINT}[[:space:]]" "$FSTAB"; then
        sed -i "\|[[:space:]]${MOUNT_POINT}[[:space:]]|d" "$FSTAB"
        systemctl daemon-reload
    fi

    if [ "$1" = "purge" ]; then
        rmdir "$MOUNT_POINT" 2>/dev/null || true
        rm -f /etc/pgbackrest.conf
    fi

    echo "Nettoyage termine. Les sauvegardes deja deposees sur le partage NFS ne sont pas supprimees."
fi

exit 0
