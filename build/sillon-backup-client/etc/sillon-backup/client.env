# Configuration du client de sauvegarde SILLON (sillon-backup-client).
#
# NFS_SHARE : partage NFS du serveur de sauvegarde (sillon-backup-server).
# Format attendu : IP_SERVEUR:/chemin/du/partage
#
# Pris en compte seulement a l'installation - apres modification,
# relancer : sudo apt-get install --reinstall sillon-backup-client
NFS_SHARE="192.168.1.40:/var/nfs/backupSILLON"
