[Unit]
Description=SILLON - Orchestrateur applicatif
After=network.target postgresql.service
Requires=postgresql.service

[Service]
WorkingDirectory=/opt/sillon-orchestrateur

# Secrets partages (§4.3, §4.4) : SILLON_JWT_SECRET (verification des jetons
# recus directement, sans passer par l'API de requetage) et
# SILLON_ORCHESTRATEUR_PASS (connexion au catalogue avec le role
# sillon_orchestrateur). Fichier genere par le postinst de sillon-server,
# chmod 600 root:root.
EnvironmentFile=/etc/sillon/secrets.env
Environment=SILLON_DB_HOST=localhost
Environment=SILLON_DB_NAME=sillon_catalog

ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 orchestrateur:app
Restart=on-failure
User=www-data

[Install]
WantedBy=multi-user.target
