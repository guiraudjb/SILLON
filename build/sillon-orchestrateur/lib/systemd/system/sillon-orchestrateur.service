[Unit]
Description=SILLON - Orchestrateur applicatif
After=network.target postgresql.service
Requires=postgresql.service

[Service]
WorkingDirectory=/opt/sillon-orchestrateur

# Secrets partages (§4.3, §4.4) : SILLON_JWT_SECRET (verification des jetons
# recus directement, sans passer par l'API de requetage) et
# SILLON_ORCHESTRATEUR_PASS (connexion au catalogue avec le role
# sillon_orchestrateur). Fichier genere par le postinst de sillon-server,
# chmod 600 root:root.
EnvironmentFile=/etc/sillon/secrets.env
Environment=SILLON_DB_HOST=localhost
Environment=SILLON_DB_NAME=sillon_catalog

# Werkzeug met en mémoire tampon disque le corps d'une requête multipart
# avant même que le code applicatif (fichier.save() vers STAGING_DIR) ne
# s'exécute - il utilise pour cela l'emplacement temporaire par défaut de
# Python (tempfile.gettempdir(), "/tmp" en l'absence de TMPDIR), qui peut
# être un tmpfs de petite taille selon l'installation (constaté en
# pratique : échec "No space left on device" sur un /tmp tmpfs de 2 Go
# pour un import de plusieurs Go, cf. sillon-demo-sirene, §12.8). Redirigé
# vers le même disque que STAGING_DIR plutôt que de dépendre de la taille
# du tmpfs système.
Environment=TMPDIR=/var/lib/sillon/staging

# --timeout : le défaut de Gunicorn (30 s) tue silencieusement le worker
# bien avant "duree_max_job_minutes" (30 min par défaut, modifiable par
# l'admin - §11) pour toute requête SQL synchrone de l'onglet Travaux
# (§5.3) qui dépasse 30 s - constaté en pratique (502 renvoyé par Nginx à
# la place du message clair de dépassement de délai). Porté à une valeur
# généreuse, cohérente avec proxy_read_timeout côté Nginx (§4, sillon-server) :
# c'est le statement_timeout PostgreSQL, pas Gunicorn, qui doit rester la
# limite réellement observée par l'utilisateur.
ExecStart=/usr/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --timeout 2100 orchestrateur:app
Restart=on-failure
User=www-data

[Install]
WantedBy=multi-user.target
