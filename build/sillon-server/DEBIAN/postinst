#!/bin/bash
set -e

echo "=== Installation de SILLON (sillon-server) ==="

# =====================================================================
# VARIABLES GLOBALES
# =====================================================================
DB_NAME="sillon_catalog"
SCHEMA_SRC="/usr/share/sillon/schema.sql"
SSL_DIR="/etc/ssl/sillon"
SECRETS_DIR="/etc/sillon"
SECRETS_FILE="$SECRETS_DIR/secrets.env"
API_CONF="/etc/sillon-api.conf"
WEB_ROOT="/var/www/html/SILLON"

PG_VERSION=$(pg_lsclusters -h 2>/dev/null | awk 'NR==1{print $1}')
pg_ctlcluster "${PG_VERSION:-17}" main start || systemctl start postgresql || true

# =====================================================================
# 1-2. DETECTION D'UNE INSTALLATION EXISTANTE, SECRETS, SCHEMA (§12.3, §12.4)
# =====================================================================
DB_EXISTE=$(sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" 2>/dev/null || true)

if [ "$DB_EXISTE" = "1" ]; then
    echo "Installation existante détectée (base $DB_NAME présente)."
    echo "Application des migrations incrémentales (§12.4) - aucune recréation du catalogue."

    # Migration : mémoire de travail dédiée à la construction des index
    # (maintenance_work_mem_defaut_mo, §7.4/§11) - absente des installations
    # antérieures à son introduction. INSERT ... ON CONFLICT DO NOTHING
    # plutôt qu'un schema.sql rejoué en entier (ce dernier échouerait sur
    # les INSERT déjà présents dans public.parametres, sans clause de
    # conflit) : le mécanisme de migration incrémentale générique reste à
    # construire (TODO ci-dessus), ceci n'est qu'un correctif ciblé.
    sudo -u postgres psql -d "$DB_NAME" -c "
        INSERT INTO public.parametres (cle, valeur) VALUES ('maintenance_work_mem_defaut_mo', '256')
        ON CONFLICT (cle) DO NOTHING;
    " >/dev/null
    sudo -u postgres psql -d "$DB_NAME" -tAc "
        DO \$\$
        DECLARE
            _maintenance_mo TEXT;
            _u RECORD;
        BEGIN
            SELECT valeur INTO _maintenance_mo FROM public.parametres WHERE cle = 'maintenance_work_mem_defaut_mo';
            FOR _u IN SELECT role_pg FROM public.utilisateurs LOOP
                EXECUTE format('ALTER ROLE %I SET maintenance_work_mem = %L', _u.role_pg, (_maintenance_mo::integer * 1024)::text);
            END LOOP;
        END \$\$;
    " >/dev/null

    # Migration : colonne nom_fichier de vue_mes_jobs (§5.5) - CREATE OR
    # REPLACE VIEW est sans risque à rejouer (contrairement à l'INSERT
    # ci-dessus), inutile d'y consacrer un correctif ciblé séparé. Colonne
    # ajoutée en dernière position (jamais au milieu) : CREATE OR REPLACE
    # VIEW n'autorise à ajouter une colonne qu'à la fin de la liste,
    # constaté en pratique (PostgreSQL refuse sinon de renommer une colonne
    # existante de la vue).
    sudo -u postgres psql -d "$DB_NAME" -c "
        CREATE OR REPLACE VIEW public.vue_mes_jobs AS
        SELECT
            j.id, j.type, j.statut, j.base_id, j.date_creation, j.date_debut, j.date_fin,
            j.message_erreur, j.message_utilisateur, j.chemin_resultat,
            CASE WHEN j.statut = 'en_attente' THEN (
                SELECT count(*) FROM public.jobs j2
                WHERE j2.statut IN ('en_attente', 'en_cours')
                  AND auth.groupe_file(j2.type) = auth.groupe_file(j.type)
                  AND j2.date_creation < j.date_creation
            ) END AS position_file,
            j.payload->>'nom_fichier' AS nom_fichier
        FROM public.jobs j
        WHERE j.utilisateur_id = public._id_courant();
    " >/dev/null

    # Migration : proxy HTTP sortant pour l'import depuis data.gouv.fr
    # (datagouv_proxy_url, §5.1) - absent des installations antérieures à
    # son introduction. Même motif que la migration ci-dessus (INSERT ...
    # ON CONFLICT DO NOTHING plutôt qu'un schema.sql rejoué en entier).
    sudo -u postgres psql -d "$DB_NAME" -c "
        INSERT INTO public.parametres (cle, valeur) VALUES ('datagouv_proxy_url', '')
        ON CONFLICT (cle) DO NOTHING;
    " >/dev/null

    # Migration : serveur de mail sortant (smtp_hote/smtp_port/smtp_expediteur,
    # §9/§10) - jusqu'ici configurable uniquement via des variables
    # d'environnement jamais renseignées par ce paquet, donc jamais
    # modifiable en pratique. Même motif que les migrations ci-dessus.
    sudo -u postgres psql -d "$DB_NAME" -c "
        INSERT INTO public.parametres (cle, valeur) VALUES
            ('smtp_hote', 'localhost'),
            ('smtp_port', '25'),
            ('smtp_expediteur', 'sillon@sillon.local')
        ON CONFLICT (cle) DO NOTHING;
    " >/dev/null

    # Migration : consentement par job à la notification par mail et à la
    # pièce jointe (§9/§10) - capturés par une modale côté client au moment
    # de la mise en file, jusqu'ici toujours implicite (mail systématique,
    # jamais de pièce jointe). creer_job() change d'arité (ajout de
    # _notifier puis _piece_jointe) : DROP explicite de chaque signature
    # antérieure avant recréation, sinon plusieurs signatures coexistent et
    # le REVOKE/GRANT le plus ancien resterait actif sur l'une d'elles
    # (constaté en pratique pour un précédent changement de signature,
    # cf. §5.5).
    sudo -u postgres psql -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "
        ALTER TABLE public.jobs ADD COLUMN IF NOT EXISTS notifier_par_mail BOOLEAN NOT NULL DEFAULT true;
        ALTER TABLE public.jobs ADD COLUMN IF NOT EXISTS joindre_piece_jointe BOOLEAN NOT NULL DEFAULT false;

        DROP FUNCTION IF EXISTS public.creer_job(public.type_job, integer, jsonb);
        DROP FUNCTION IF EXISTS public.creer_job(public.type_job, integer, jsonb, boolean);

        CREATE OR REPLACE FUNCTION public.creer_job(_type public.type_job, _base_id INTEGER, _payload JSONB DEFAULT '{}'::jsonb, _notifier BOOLEAN DEFAULT true, _piece_jointe BOOLEAN DEFAULT false)
        RETURNS INTEGER AS \$\$
        DECLARE
            _id_job           INTEGER;
            _max_simultanes   INTEGER;
            _en_cours         INTEGER;
            _proprietaire     BOOLEAN;
            _autorise_scripts BOOLEAN;
        BEGIN
            IF _type = 'creation_base' THEN
                IF _base_id IS NOT NULL THEN
                    RAISE EXCEPTION 'creation_base ne porte jamais de base cible';
                END IF;
            ELSE
                IF _base_id IS NULL THEN
                    RAISE EXCEPTION 'base_id requis pour ce type de job';
                END IF;

                SELECT (b.proprietaire_id = public._id_courant()), COALESCE(p.autorise_scripts, false)
                INTO _proprietaire, _autorise_scripts
                FROM public.bases b
                LEFT JOIN public.partages p ON p.base_id = b.id AND p.beneficiaire_id = public._id_courant()
                WHERE b.id = _base_id AND (b.proprietaire_id = public._id_courant() OR p.beneficiaire_id = public._id_courant());

                IF NOT FOUND THEN
                    RAISE EXCEPTION 'Base introuvable ou inaccessible';
                END IF;

                IF _type = 'suppression_base' AND NOT _proprietaire THEN
                    RAISE EXCEPTION 'Seul le proprietaire de la base peut la supprimer';
                END IF;

                IF _type IN ('script_python', 'script_r') AND NOT _proprietaire AND NOT _autorise_scripts THEN
                    RAISE EXCEPTION 'Execution de script non autorisee sur cette base';
                END IF;
            END IF;

            SELECT valeur::INTEGER INTO _max_simultanes FROM public.parametres WHERE cle = 'jobs_simultanes_par_utilisateur';
            SELECT count(*) INTO _en_cours FROM public.jobs
                WHERE utilisateur_id = public._id_courant() AND statut IN ('en_attente', 'en_cours');

            IF _en_cours >= _max_simultanes THEN
                RAISE EXCEPTION 'Quota de jobs simultanes atteint (%). Voir §11.', _max_simultanes;
            END IF;

            INSERT INTO public.jobs (utilisateur_id, type, base_id, payload, notifier_par_mail, joindre_piece_jointe)
            VALUES (public._id_courant(), _type, _base_id, (_payload - 'nom_pg' - 'role_pg'), _notifier, _piece_jointe)
            RETURNING id INTO _id_job;

            PERFORM pg_notify('sillon_jobs', _id_job::text);

            RETURN _id_job;
        END;
        \$\$ LANGUAGE plpgsql SECURITY DEFINER;

        REVOKE EXECUTE ON FUNCTION public.creer_job(public.type_job, integer, jsonb, boolean, boolean) FROM PUBLIC;
        GRANT EXECUTE ON FUNCTION public.creer_job(public.type_job, integer, jsonb, boolean, boolean) TO agent;
    " >/dev/null

    # Migration : partage automatique du jeu de donnees du tutoriel a la
    # creation de chaque nouveau compte, si sillon-tutoriel est installe
    # (§7.2) - meme arite, CREATE OR REPLACE suffit (REVOKE/GRANT deja en
    # place, contrairement a la migration creer_job ci-dessus).
    sudo -u postgres psql -d "$DB_NAME" -v ON_ERROR_STOP=1 -c "
        CREATE OR REPLACE FUNCTION public.creer_utilisateur(_email TEXT, _password TEXT, _nom_complet TEXT, _profil public.profil_utilisateur)
        RETURNS void AS \$\$
        DECLARE
            _role_pg        TEXT;
            _work_mem_mo    TEXT;
            _maintenance_mo TEXT;
            _connexions_max INTEGER;
            _user_id        INTEGER;
            _demo_id        INTEGER;
            _demo_base_id   INTEGER;
        BEGIN
            _role_pg := auth.nom_role_personnel(_email);

            SELECT valeur INTO _work_mem_mo FROM public.parametres WHERE cle = 'work_mem_defaut_mo';
            SELECT valeur INTO _maintenance_mo FROM public.parametres WHERE cle = 'maintenance_work_mem_defaut_mo';
            SELECT valeur::INTEGER INTO _connexions_max FROM public.parametres WHERE cle = 'connexions_max_par_utilisateur';

            EXECUTE format('CREATE ROLE %I NOLOGIN CONNECTION LIMIT %s', _role_pg, _connexions_max);
            EXECUTE format('ALTER ROLE %I SET work_mem = %L', _role_pg, (_work_mem_mo::integer * 1024)::text);
            EXECUTE format('ALTER ROLE %I SET maintenance_work_mem = %L', _role_pg, (_maintenance_mo::integer * 1024)::text);

            EXECUTE format('GRANT %I TO sillon_service', _role_pg);
            EXECUTE format('GRANT %I TO sillon_orchestrateur', _role_pg);
            EXECUTE format('GRANT %I TO %I', _profil::text, _role_pg);

            INSERT INTO public.utilisateurs (email, mot_de_passe_hash, nom_complet, profil, role_pg)
            VALUES (_email, crypt(_password, gen_salt('bf')), _nom_complet, _profil, _role_pg)
            RETURNING id INTO _user_id;

            IF _email <> 'demo@sillon.local' AND EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'sillon_tutoriel_lecteurs') THEN
                SELECT u.id, b.id INTO _demo_id, _demo_base_id
                FROM public.utilisateurs u JOIN public.bases b ON b.proprietaire_id = u.id
                WHERE u.email = 'demo@sillon.local';

                IF FOUND THEN
                    EXECUTE format('GRANT sillon_tutoriel_lecteurs TO %I', _role_pg);
                    INSERT INTO public.partages (base_id, beneficiaire_id, accorde_par_id, autorise_scripts)
                    VALUES (_demo_base_id, _user_id, _demo_id, true)
                    ON CONFLICT (base_id, beneficiaire_id) DO NOTHING;
                END IF;
            END IF;
        END;
        \$\$ LANGUAGE plpgsql SECURITY DEFINER;

        REVOKE EXECUTE ON FUNCTION public.creer_utilisateur(text, text, text, public.profil_utilisateur) FROM PUBLIC;
        GRANT EXECUTE ON FUNCTION public.creer_utilisateur(text, text, text, public.profil_utilisateur) TO administrateur;
    " >/dev/null

    # Les secrets existants sont conservés tels quels (§12.3) : les
    # régénérer invaliderait toutes les sessions actives et romprait la
    # connexion des paquets déjà installés (sillon-orchestrateur, sillon-worker).
    if [ ! -f "$SECRETS_FILE" ]; then
        echo "ERREUR : base existante mais fichier de secrets introuvable ($SECRETS_FILE)." >&2
        echo "Intervention manuelle requise avant de poursuivre la mise à jour." >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$SECRETS_FILE"

else
    echo "Aucune installation existante : premier déploiement."

    # Génération aléatoire des secrets (§12.3) - jamais fournis en dur dans
    # le paquet, jamais commités dans un dépôt de code.
    SILLON_JWT_SECRET=$(tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c 48)
    SILLON_SERVICE_PASS=$(tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c 24)
    SILLON_ORCHESTRATEUR_PASS=$(tr -dc 'A-Za-z0-9_-' < /dev/urandom | head -c 24)
    ADMIN_EMAIL="admin@sillon.local"
    ADMIN_PASS=$(tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 16)

    mkdir -p "$SECRETS_DIR"
    cat << EOF > "$SECRETS_FILE"
SILLON_JWT_SECRET=${SILLON_JWT_SECRET}
SILLON_SERVICE_PASS=${SILLON_SERVICE_PASS}
SILLON_ORCHESTRATEUR_PASS=${SILLON_ORCHESTRATEUR_PASS}
EOF
    # Lu par ce paquet et par les paquets sillon-orchestrateur / sillon-worker
    # installés ensuite (§4.4) : accès restreint au compte système.
    chmod 600 "$SECRETS_FILE"
    chown root:root "$SECRETS_FILE"

    echo "Création de la base $DB_NAME et déploiement du catalogue (§6)..."
    sudo -u postgres psql -c "CREATE DATABASE $DB_NAME;"

    TMP_SCHEMA=$(mktemp)
    cp "$SCHEMA_SRC" "$TMP_SCHEMA"
    sed -i "s/__JWT_SECRET__/$SILLON_JWT_SECRET/g" "$TMP_SCHEMA"
    sed -i "s/__SERVICE_PASS__/$SILLON_SERVICE_PASS/g" "$TMP_SCHEMA"
    sed -i "s/__ORCHESTRATEUR_PASS__/$SILLON_ORCHESTRATEUR_PASS/g" "$TMP_SCHEMA"
    sed -i "s/__ADMIN_EMAIL__/$ADMIN_EMAIL/g" "$TMP_SCHEMA"
    sed -i "s/__ADMIN_PASS__/$ADMIN_PASS/g" "$TMP_SCHEMA"

    # Redirection par entrée standard plutôt que "-f" : mktemp crée le
    # fichier en mode 600 appartenant à root, illisible par l'utilisateur
    # système "postgres" que sudo -u fait exécuter psql - "psql -f" tente
    # de rouvrir le fichier depuis ce contexte et échoue avec "Permission
    # non accordée" (constaté lors d'un déploiement réel sur VM). En
    # entrée standard, seul ce script (root) lit le fichier ; son contenu
    # est simplement transmis au processus psql, sans accès disque requis
    # côté "postgres".
    sudo -u postgres psql -d "$DB_NAME" -v ON_ERROR_STOP=1 < "$TMP_SCHEMA"
    rm -f "$TMP_SCHEMA"

    # Écrit dans un fichier root-only plutôt qu'affiché sur la sortie
    # standard (§8.11) : la sortie d'un postinst est typiquement capturée
    # dans des journaux persistants (/var/log/apt/term.log, journal
    # systemd selon le mode d'installation) dont la protection n'est pas
    # équivalente à celle de $SECRETS_FILE (chmod 600 root:root, ci-dessus)
    # - afficher le mot de passe administrateur en clair y créait une
    # seconde copie durable, moins bien maîtrisée (cf. rapport d'audit de
    # sécurité).
    ADMIN_CREDS_FILE="/root/sillon-admin-initial.txt"
    cat << EOF > "$ADMIN_CREDS_FILE"
Identifiant administrateur initial : ${ADMIN_EMAIL}
Mot de passe administrateur initial : ${ADMIN_PASS}

À changer dès la première connexion (panneau Administration), puis à
supprimer ce fichier.
EOF
    chmod 600 "$ADMIN_CREDS_FILE"
    chown root:root "$ADMIN_CREDS_FILE"

    echo "=== Identifiants administrateur initiaux écrits dans $ADMIN_CREDS_FILE (lecture root uniquement) ==="
    echo "=== À consulter puis à changer dès la première connexion ==="
fi

# =====================================================================
# 2bis. DIMENSIONNEMENT DU MOTEUR POSTGRESQL (§7.1)
# =====================================================================
# Valeurs calculées à partir de la RAM et du nombre de cœurs réels de la
# machine (comme ADRESSE_HOTE dans sillon-worker, §7.7 : redétecté à
# chaque installation plutôt que supposé stable) plutôt que des constantes
# arbitraires - un serveur de démonstration modeste et un serveur de
# production dimensionné n'ont pas les mêmes ordres de grandeur.
PG_CONF_DIR="/etc/postgresql/${PG_VERSION:-17}/main"
RAM_TOTALE_MO=$(awk '/MemTotal/{printf "%d", $2/1024}' /proc/meminfo 2>/dev/null || echo 0)
NB_CPU=$(nproc 2>/dev/null || echo 1)

if [ -f "$PG_CONF_DIR/postgresql.conf" ] && [ "$RAM_TOTALE_MO" -gt 0 ]; then
    # shared_buffers ~ un quart de la RAM (cache géré par le moteur
    # lui-même) ; effective_cache_size ~ trois quarts (RAM réellement
    # disponible pour le cache disque du système, shared_buffers inclus -
    # n'alloue rien en soi, indique seulement au planificateur ce qu'il
    # peut espérer trouver déjà en cache).
    SHARED_BUFFERS_MO=$((RAM_TOTALE_MO / 4))
    EFFECTIVE_CACHE_MO=$((RAM_TOTALE_MO * 3 / 4))

    # Parallélisation dimensionnée sur le nombre de cœurs (§7.1) : les
    # requêtes analytiques sur de gros volumes, cas d'usage central de
    # SILLON, en bénéficient directement. max_parallel_workers_per_gather
    # à la moitié du total, jamais en dessous de 1 sur une machine mono-cœur.
    MAX_PARALLEL_GATHER=$((NB_CPU / 2))
    if [ "$MAX_PARALLEL_GATHER" -lt 1 ]; then MAX_PARALLEL_GATHER=1; fi

    REDEMARRAGE_REQUIS=0
    RECHARGEMENT_REQUIS=0

    # Une seule fonction pour le motif idempotent "grep puis sed ou append"
    # déjà utilisé par ailleurs (listen_addresses, sillon-worker/postinst) :
    # ne réécrit le fichier, et ne redémarre/recharge, que si la valeur
    # cible n'y est pas déjà - une réinstallation ne doit jamais perturber
    # un serveur déjà correctement réglé.
    regler_postgresql_conf() {
        cle="$1"; valeur="$2"; besoin_redemarrage="$3"
        if grep -qE "^${cle}\s*=\s*${valeur}(\s|\$)" "$PG_CONF_DIR/postgresql.conf"; then
            return
        fi
        if grep -qE "^#?${cle}\b" "$PG_CONF_DIR/postgresql.conf"; then
            sed -i "s/^#\?${cle}[[:space:]]*=.*/${cle} = ${valeur}/" "$PG_CONF_DIR/postgresql.conf"
        else
            echo "${cle} = ${valeur}" >> "$PG_CONF_DIR/postgresql.conf"
        fi
        if [ "$besoin_redemarrage" = "1" ]; then REDEMARRAGE_REQUIS=1; else RECHARGEMENT_REQUIS=1; fi
    }

    # maintenance_work_mem (§7.4) : accélère la construction des index GIN
    # trigram créés automatiquement à chaque import CSV - constaté en
    # pratique, la valeur par défaut de PostgreSQL (quelques dizaines de
    # Mo) ralentit nettement cette étape pour un import volumineux.
    # Complémentaire du réglage par rôle (maintenance_work_mem_defaut_mo,
    # public.parametres), qui prime pour un utilisateur donné - celui-ci
    # ne sert que de plancher pour toute connexion sans réglage explicite.
    regler_postgresql_conf "maintenance_work_mem" "256MB" 0
    regler_postgresql_conf "shared_buffers" "${SHARED_BUFFERS_MO}MB" 1
    regler_postgresql_conf "effective_cache_size" "${EFFECTIVE_CACHE_MO}MB" 0
    regler_postgresql_conf "max_worker_processes" "$NB_CPU" 1
    regler_postgresql_conf "max_parallel_workers" "$NB_CPU" 0
    regler_postgresql_conf "max_parallel_workers_per_gather" "$MAX_PARALLEL_GATHER" 0
    # Points de contrôle desserrés (§7.1) : absorbe les pics d'écriture des
    # imports en masse sans dégrader la latence perçue par les autres
    # utilisateurs actifs au même moment (contexte "sighup", jamais de
    # redémarrage requis).
    regler_postgresql_conf "checkpoint_timeout" "15min" 0
    regler_postgresql_conf "max_wal_size" "4GB" 0
    # pg_stat_statements (§7.1) : permet a posteriori d'identifier les
    # requêtes les plus coûteuses et d'ajuster réglages/quotas en
    # connaissance de cause - contexte "postmaster", seul réglage de ce
    # bloc à nécessiter un redémarrage plutôt qu'un simple rechargement.
    regler_postgresql_conf "shared_preload_libraries" "'pg_stat_statements'" 1

    if [ "$REDEMARRAGE_REQUIS" = "1" ]; then
        systemctl restart postgresql 2>/dev/null || pg_ctlcluster "${PG_VERSION:-17}" main restart 2>/dev/null || true
    elif [ "$RECHARGEMENT_REQUIS" = "1" ]; then
        systemctl reload postgresql 2>/dev/null || pg_ctlcluster "${PG_VERSION:-17}" main reload 2>/dev/null || true
    fi

    # CREATE EXTENSION séparé de shared_preload_libraries (§7.1) : ce
    # dernier charge le module dans le moteur, l'extension expose la vue
    # public.pg_stat_statements dans une base donnée - ici le catalogue,
    # qui centralise déjà les autres vues d'administration (§6). Non
    # bloquant : l'absence de pg_stat_statements ne doit jamais empêcher
    # le reste de l'installation d'aboutir.
    sudo -u postgres psql -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS pg_stat_statements;" >/dev/null 2>&1 || \
        echo "AVERTISSEMENT : extension pg_stat_statements indisponible (§7.1) - suivi des requêtes coûteuses non actif." >&2
fi

# =====================================================================
# 3. CONFIGURATION DE L'API DE REQUETAGE (§4.3)
# =====================================================================
echo "Configuration de l'API de requêtage..."
cat << EOF > "$API_CONF"
db-uri = "postgres://sillon_service:${SILLON_SERVICE_PASS}@localhost:5432/${DB_NAME}"
db-schema = "public"
db-anon-role = "sillon_service"
jwt-secret = "${SILLON_JWT_SECRET}"
server-port = 3000
server-host = "127.0.0.1"
EOF
chmod 600 "$API_CONF"
chown www-data:www-data "$API_CONF"

# =====================================================================
# 4. CERTIFICAT TLS ET SITE NGINX (§8.5)
# =====================================================================
echo "Vérification du certificat TLS..."
mkdir -p "$SSL_DIR"
if [ ! -f "$SSL_DIR/sillon.crt" ]; then
    # Auto-signé, à remplacer par un certificat institutionnel avant mise en
    # production (§12.3). Généré une seule fois : ne jamais écraser un
    # certificat institutionnel déjà installé par l'administrateur lors
    # d'une mise à jour ultérieure du paquet.
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
        -keyout "$SSL_DIR/sillon.key" -out "$SSL_DIR/sillon.crt" \
        -subj "/C=FR/ST=Paris/L=Paris/O=Direction/OU=SILLON/CN=localhost" 2>/dev/null
fi
chown root:www-data "$SSL_DIR/sillon.key"
chown root:root "$SSL_DIR/sillon.crt"
chmod 640 "$SSL_DIR/sillon.key"
chmod 644 "$SSL_DIR/sillon.crt"
chmod 755 "$SSL_DIR"

echo "Application des droits sur le dossier web..."
chmod -R 755 "$WEB_ROOT"
chown -R www-data:www-data "$WEB_ROOT"

ln -sf /etc/nginx/sites-available/sillon /etc/nginx/sites-enabled/sillon
rm -f /etc/nginx/sites-enabled/default || true

# =====================================================================
# 5. ANTI-BRUTEFORCE : LIMITATION DE DEBIT + FAIL2BAN (§8.6)
# =====================================================================
echo "Mise en place de l'anti-bruteforce..."

cat << EOF > /etc/nginx/conf.d/sillon-ratelimit.conf
# Zone mémoire pour limiter les tentatives de connexion SILLON (§8.6)
limit_req_zone \$binary_remote_addr zone=login_limit:10m rate=3r/s;
limit_req_status 429;
EOF

cat << EOF > /etc/fail2ban/filter.d/sillon-login.conf
[Definition]
failregex = ^<HOST> \- \- \[.*\] "POST /api/rpc/login HTTP.*" (400|401|429) .+$
ignoreregex =
EOF

cat << EOF > /etc/fail2ban/jail.d/sillon-login.conf
[sillon-login]
enabled  = true
port     = http,https
filter   = sillon-login
logpath  = /var/log/nginx/access.log
maxretry = 5
findtime = 600
bantime  = 3600
EOF

systemctl restart fail2ban
systemctl enable fail2ban

# =====================================================================
# 6. PURGE AUTOMATIQUE DU JOURNAL D'AUDIT (§8.12)
# =====================================================================
# Le fichier /etc/cron.d/sillon_purge_logs est livré par le paquet ; on
# s'assure ici de ses droits (exigence standard pour /etc/cron.d).
chown root:root /etc/cron.d/sillon_purge_logs
chmod 644 /etc/cron.d/sillon_purge_logs

# =====================================================================
# 6bis. PURGE AUTOMATIQUE DES RESULTATS DE JOBS (§8.9, §5.4)
# =====================================================================
chown root:root /etc/cron.d/sillon_purge_resultats
chmod 644 /etc/cron.d/sillon_purge_resultats

# =====================================================================
# 7. REPERTOIRE DE DEPOT TEMPORAIRE DES IMPORTS CSV (§5.1)
# =====================================================================
# Utilisé par l'orchestrateur entre /import/apercu et /import/valider
# (orchestrateur.py, STAGING_DIR) ; sans ce répertoire pré-créé avec les
# bons droits, le service retombe sur /tmp au démarrage, ce qui fonctionne
# mais sort du périmètre géré par le paquet.
mkdir -p /var/lib/sillon/staging
# Résultats de jobs (RESULTATS_DIR, partagé par orchestrateur.py et
# sillon-worker : exports SQL différés §5.3, archives de scripts §5.4) -
# même repli sur /tmp sinon, et purgé par sillon_purge_resultats ci-dessus.
mkdir -p /var/lib/sillon/resultats
chown -R www-data:www-data /var/lib/sillon
chmod 750 /var/lib/sillon/staging
chmod 750 /var/lib/sillon/resultats
# Point de vigilance non traité ici : un fichier déposé via /import/apercu
# et jamais validé reste indéfiniment dans ce répertoire (§15.2, à traiter
# avec une purge périodique le jour où ça devient nécessaire).

# =====================================================================
# ACTIVATION DES SERVICES
# =====================================================================
systemctl daemon-reload
systemctl enable sillon-api
systemctl restart sillon-api
systemctl restart nginx

echo "=== Installation de SILLON (sillon-server) terminée ==="
exit 0
