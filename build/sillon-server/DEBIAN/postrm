#!/bin/bash
set -e

# Meme appel qu'en preinst/postinst (voir preinst pour le detail) - exige
# par dpkg-maintscript-helper pour rm_conffile, sans quoi le retrait de ces
# deux cron.d ne serait pas nettoye correctement lors d'un "remove"/"purge".
dpkg-maintscript-helper rm_conffile \
    /etc/cron.d/sillon_purge_logs 0.1.32~ -- "$@"
dpkg-maintscript-helper rm_conffile \
    /etc/cron.d/sillon_purge_resultats 0.1.32~ -- "$@"

DB_NAME="sillon_catalog"

# =====================================================================
# NETTOYAGE DES ARTEFACTS GENERES PAR LE POSTINST (§12.6)
# =====================================================================
# Ces fichiers ne font pas partie de l'arborescence livrée par le paquet
# (ils sont créés dynamiquement par postinst avec des "cat << EOF") : dpkg
# ne les retire jamais de lui-même, il faut le faire ici explicitement.
nettoyer_artefacts_runtime() {
    rm -f /etc/nginx/sites-enabled/sillon
    rm -f /etc/nginx/conf.d/sillon-ratelimit.conf
    rm -f /etc/fail2ban/filter.d/sillon-login.conf
    rm -f /etc/fail2ban/jail.d/sillon-login.conf

    if command -v nginx >/dev/null 2>&1 && systemctl is-active --quiet nginx 2>/dev/null; then
        nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
    fi
    if command -v fail2ban-client >/dev/null 2>&1 && systemctl is-active --quiet fail2ban 2>/dev/null; then
        systemctl restart fail2ban || true
    fi
}

case "$1" in
    remove)
        nettoyer_artefacts_runtime
        # /etc/sillon/secrets.env et /etc/sillon-api.conf sont conservés :
        # une réinstallation doit pouvoir reprendre à l'identique (§12.4),
        # sans régénérer de nouveaux secrets ni perdre l'accès aux bases
        # déjà créées par les directions utilisatrices.
        ;;

    purge)
        nettoyer_artefacts_runtime

        # Purge complète du catalogue applicatif et des rôles PostgreSQL
        # qu'il porte (§12.6 révisé) : "purge" retrouve la sémantique
        # standard dpkg - suppression totale, sans reste - afin qu'un cycle
        # purge+réinstallation soit idempotent. Auparavant, la base et ses
        # rôles survivaient volontairement au purge ; un rôle personnel au
        # nom déterministe (auth.nom_role_personnel, dérivé de l'e-mail
        # admin fixe "admin@sillon.local") restait alors en collision avec
        # celui qu'une réinstallation tentait de recréer ("role already
        # exists"), constaté lors d'un déploiement réel sur VM.
        #
        # Portée volontairement limitée au catalogue lui-même : les bases
        # de travail créées par les agents (§4.4, CREATE DATABASE distinct
        # de $DB_NAME) ne sont jamais touchées ici, ce ne sont pas des
        # artefacts d'installation de ce paquet.
        if command -v psql >/dev/null 2>&1 \
            && sudo -u postgres psql -tAc \
                "SELECT 1 FROM pg_database WHERE datname = '$DB_NAME'" 2>/dev/null | grep -q 1; then
            echo "Suppression du catalogue applicatif ($DB_NAME) et des rôles associés..." >&2

            # Les rôles personnels (u_...) sont lus dans le catalogue avant
            # sa suppression : leur nom n'est pas déterminable autrement
            # une fois la base disparue.
            ROLES_PERSONNELS=$(sudo -u postgres psql -tAc \
                "SELECT role_pg FROM public.utilisateurs" -d "$DB_NAME" 2>/dev/null || true)

            # "|| true" : une connexion résiduelle échappant à l'arrêt des
            # services en prerm ne doit pas faire échouer toute la purge
            # (config, secrets, /var/lib/sillon resteraient sinon en place
            # malgré un "purge" en apparence terminé) - message affiché
            # plutôt qu'étouffé.
            sudo -u postgres dropdb --if-exists "$DB_NAME" \
                || echo "AVERTISSEMENT : suppression de $DB_NAME échouée (connexion active ?) - à retirer manuellement avant réinstallation : sudo -u postgres dropdb $DB_NAME" >&2

            # "|| true" par rôle : un rôle encore titulaire d'un privilège
            # sur une base de travail (§4.4, hors périmètre de ce paquet)
            # ne doit pas interrompre la purge des autres - message affiché
            # plutôt qu'étouffé, pour rester visible de l'administrateur.
            for role in $ROLES_PERSONNELS; do
                sudo -u postgres psql -c "DROP ROLE IF EXISTS \"$role\";" >/dev/null \
                    || echo "AVERTISSEMENT : rôle PostgreSQL \"$role\" non supprimé (probablement encore titulaire de privilèges sur une base de travail)." >&2
            done
            # Rôles "gabarits" et de service, communs à toutes les
            # installations (créés par schema.sql §4).
            for role in sillon_service sillon_orchestrateur lecteur agent administrateur; do
                sudo -u postgres psql -c "DROP ROLE IF EXISTS $role;" >/dev/null \
                    || echo "AVERTISSEMENT : rôle PostgreSQL $role non supprimé (probablement encore titulaire de privilèges sur une base de travail)." >&2
            done
        fi

        rm -f /etc/sillon-api.conf
        rm -rf /etc/sillon
        rm -rf /etc/ssl/sillon
        rm -rf /var/lib/sillon
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Rien à faire : la nouvelle version du paquet (ou l'annulation de
        # l'opération) régénère ou conserve ce qui est nécessaire.
        ;;
esac

exit 0
