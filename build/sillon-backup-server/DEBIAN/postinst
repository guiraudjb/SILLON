#!/bin/bash
set -e

# Doit etre la toute premiere action du script, avant le moindre echo : tant
# que confmodule n'a pas redirige la sortie standard (exec 1>&2 en interne),
# fd1 EST le tube protocolaire lu par le frontend debconf quand ce postinst
# est invoque comme processus confmodule - tout texte ecrit sur stdout avant
# cette ligne est alors interprete comme une commande du protocole debconf
# et le fait echouer avec "syntaxerror" (code de sortie 20). Constate en
# conditions reelles sur la VM de test : un "apt install" avec ce echo place
# avant l'appel a confmodule faisait systematiquement echouer ce postinst.
# shellcheck disable=SC1091
. /usr/share/debconf/confmodule

echo "=== Installation de SILLON (sillon-backup-server) ==="

CONF_ENV="/etc/sillon-backup/server.env"
SHARE_DIR="/var/nfs/backupSILLON"
PGBACKREST_CONF="/etc/pgbackrest.conf"

# Reponse recueillie par DEBIAN/config (menu interactif debconf) - modifiable
# ensuite via "sudo dpkg-reconfigure sillon-backup-server" sans reinstaller.
db_get sillon-backup-server/client_ip
CLIENT_IP="$RET"

mkdir -p "$(dirname "$CONF_ENV")"
cat << EOF > "$CONF_ENV"
# Configuration du serveur de sauvegarde SILLON (sillon-backup-server).
#
# CLIENT_IP : adresse IP du serveur SILLON (le seul autorise a deposer
# des sauvegardes sur ce partage NFS).
#
# Genere par le menu interactif d'installation - pour modifier :
#   sudo dpkg-reconfigure sillon-backup-server
CLIENT_IP="${CLIENT_IP}"
EOF
chmod 644 "$CONF_ENV"

db_stop

mkdir -p "$SHARE_DIR"
chown nobody:nogroup "$SHARE_DIR"
chmod 700 "$SHARE_DIR"

if [ -z "$CLIENT_IP" ]; then
    echo "ATTENTION : aucune IP client renseignee dans $CONF_ENV - le partage NFS est suspendu." >&2
else
    touch /etc/exports
    if ! grep -q "$SHARE_DIR $CLIENT_IP" /etc/exports; then
        echo "$SHARE_DIR $CLIENT_IP(rw,sync,no_subtree_check,all_squash)" >> /etc/exports
    fi
    exportfs -ra
    systemctl restart nfs-kernel-server
    echo "Succes : le dossier $SHARE_DIR est partage et securise pour l'IP $CLIENT_IP."
fi

# Configuration minimale pour que "pgbackrest info"/"expire" fonctionnent
# directement depuis ce serveur (repo-host), sans avoir besoin de
# contacter le serveur SILLON - utilise par sillon-backup-server-survey.
cat << EOF > "$PGBACKREST_CONF"
[global]
repo1-path=${SHARE_DIR}
EOF
chmod 644 "$PGBACKREST_CONF"

echo "=== Installation de SILLON (sillon-backup-server) terminee ==="
exit 0
